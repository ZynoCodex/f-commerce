# Copy this file to .env and adjust the values for your machine.
# .env is gitignored and is the file the app reads; this example is the
# tracked template that documents every variable.

# The API origin this Next.js server proxies /api/* to.
# Local development points at the Express dev server. Every deployed environment
# sets it to that environment's API URL, so no host name lives in the code.
API_ORIGIN=http://localhost:4000
