# Copy this file to .env and adjust the values for your machine.
# .env is gitignored and is the file the backend reads; this example is the
# tracked template that documents every variable.

NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://postgres:local@localhost:5432/f-commerce
# Optional. Defaults to DATABASE_URL with a "-test" suffix, for example
# postgresql://postgres:local@localhost:5432/f-commerce-test, and is created on
# first test run. Set this to point tests at a dedicated server instead.
TEST_DATABASE_URL=
REDIS_URL=redis://:fcommerce@localhost:6379
JWT_SECRET=replace-with-a-long-development-secret
JWT_REFRESH_SECRET=replace-with-a-long-development-secret
# Access tokens expire after 15 minutes and refresh tokens after 7 days; the
# TTLs are fixed in code.
CORS_ORIGINS=http://localhost:3000
CLOUDINARY_CLOUD_NAME=replace-me
CLOUDINARY_API_KEY=replace-me
CLOUDINARY_API_SECRET=replace-me
