{
  "name": "f-commerce",
  "version": "0.1.0",
  "private": true,
  "description": "F-Commerce Order Manager",
  "workspaces": [
    "packages/contracts",
    "frontend",
    "backend"
  ],
  "engines": {
    "node": ">=24 <25",
    "npm": ">=11 <12"
  },
  "scripts": {
    "dev": "concurrently -k -n frontend,backend -c blue,green \"npm run dev --workspace @f-commerce/frontend\" \"npm run dev --workspace @f-commerce/backend\"",
    "build": "npm run build --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "^9.35.0",
    "@playwright/test": "^1.63.0",
    "@types/multer": "^2.2.0",
    "concurrently": "^9.2.1",
    "drizzle-orm": "^0.45.4",
    "eslint": "^9.35.0",
    "prettier": "^3.6.2",
    "typescript-eslint": "^8.42.0"
  },
  "dependencies": {
    "cloudinary": "^2.11.0",
    "cors": "^2.8.6",
    "multer": "^2.4.0",
    "tsx": "^4.23.15"
  },
  "allowScripts": {
    "bcrypt@6.0.0": true,
    "esbuild@0.28.2": true,
    "esbuild@0.25.12": true,
    "esbuild@0.18.20": true,
    "unrs-resolver@1.12.2": true
  }
}
