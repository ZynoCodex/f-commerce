{
  "name": "f-commerce",
  "version": "0.1.0",
  "private": true,
  "description": "F-Commerce Order Manager",
  "workspaces": [
    "frontend",
    "backend",
    "packages/contracts"
  ],
  "engines": {
    "node": ">=22 <23",
    "npm": ">=10 <11"
  },
  "scripts": {
    "dev": "concurrently -k -n frontend,backend -c blue,green \"npm run dev --workspace @f-commerce/frontend\" \"npm run dev --workspace @f-commerce/backend\"",
    "build": "npm run build --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "^9.35.0",
    "@playwright/test": "^1.63.0",
    "@types/multer": "^2.2.0",
    "concurrently": "^9.2.1",
    "eslint": "^9.35.0",
    "prettier": "^3.6.2",
    "typescript-eslint": "^8.42.0"
  },
  "dependencies": {
    "cloudinary": "^2.11.0",
    "cors": "^2.8.6",
    "multer": "^2.4.0",
    "tsx": "^4.23.15"
  }
}
